from flask import Flask, jsonify
import pymysql

app = Flask(__name__)

DB_HOST = "{{ db_ip }}"
DB_USER = "{{ db_user }}"
DB_PASSWORD = "{{ db_password }}"
DB_NAME = "{{ db_name }}"

@app.route("/health")
def health():
    return jsonify(status="ok", tier="app")

@app.route("/db-check")
def db_check():
    try:
        conn = pymysql.connect(host=DB_HOST, user=DB_USER, password=DB_PASSWORD, database=DB_NAME, connect_timeout=3)
        conn.close()
        return jsonify(status="ok", db="reachable")
    except Exception as e:
        return jsonify(status="error", detail=str(e)), 500

if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000)
