terraform {
  required_providers {
    openstack = {
      source  = "terraform-provider-openstack/openstack"
      version = "~> 3.0"
    }
  }
}

provider "openstack" {
  auth_url    = var.auth_url
  user_name   = var.user_name
  password    = var.password
  tenant_name = var.tenant_name
}

# --- Réseau privé ---
resource "openstack_networking_network_v2" "private_network" {
  name           = "net-3tiers-private"
  admin_state_up = true
}

resource "openstack_networking_subnet_v2" "private_subnet" {
  name       = "net-3tiers-subnet"
  network_id = openstack_networking_network_v2.private_network.id
  cidr       = "10.20.0.0/24"
  ip_version = 4
  dns_nameservers = ["8.8.8.8"]
}

# --- Réseau externe (déjà créé dans Neutron par l'administrateur) ---
data "openstack_networking_network_v2" "external_network" {
  name = var.external_network_name
}

# --- Routeur avec passerelle vers l'extérieur ---
resource "openstack_networking_router_v2" "router" {
  name                = "net-3tiers-router"
  admin_state_up      = true
  external_network_id = data.openstack_networking_network_v2.external_network.id
}

resource "openstack_networking_router_interface_v2" "router_interface" {
  router_id = openstack_networking_router_v2.router.id
  subnet_id = openstack_networking_subnet_v2.private_subnet.id
}

# --- Security Group : Web ---
resource "openstack_networking_secgroup_v2" "sg_web" {
  name        = "sg-web"
  description = "HTTP/HTTPS depuis l'extérieur + SSH pour administration"
}

resource "openstack_networking_secgroup_rule_v2" "web_http" {
  direction         = "ingress"
  ethertype         = "IPv4"
  protocol          = "tcp"
  port_range_min    = 80
  port_range_max    = 80
  remote_ip_prefix  = "0.0.0.0/0"
  security_group_id = openstack_networking_secgroup_v2.sg_web.id
}

resource "openstack_networking_secgroup_rule_v2" "web_https" {
  direction         = "ingress"
  ethertype         = "IPv4"
  protocol          = "tcp"
  port_range_min    = 443
  port_range_max    = 443
  remote_ip_prefix  = "0.0.0.0/0"
  security_group_id = openstack_networking_secgroup_v2.sg_web.id
}

resource "openstack_networking_secgroup_rule_v2" "web_ssh" {
  direction         = "ingress"
  ethertype         = "IPv4"
  protocol          = "tcp"
  port_range_min    = 22
  port_range_max    = 22
  remote_ip_prefix  = "0.0.0.0/0"
  security_group_id = openstack_networking_secgroup_v2.sg_web.id
}

resource "openstack_networking_secgroup_rule_v2" "web_icmp" {
  direction         = "ingress"
  ethertype         = "IPv4"
  protocol          = "icmp"
  remote_ip_prefix  = "10.20.0.0/24"
  security_group_id = openstack_networking_secgroup_v2.sg_web.id
}

# --- Security Group : App ---
resource "openstack_networking_secgroup_v2" "sg_app" {
  name        = "sg-app"
  description = "HTTP applicatif uniquement depuis la VM Web"
}

resource "openstack_networking_secgroup_rule_v2" "app_from_web_5000" {
  direction         = "ingress"
  ethertype         = "IPv4"
  protocol          = "tcp"
  port_range_min    = 5000
  port_range_max    = 5000
  remote_group_id   = openstack_networking_secgroup_v2.sg_web.id
  security_group_id = openstack_networking_secgroup_v2.sg_app.id
}

resource "openstack_networking_secgroup_rule_v2" "app_from_web_8080" {
  direction         = "ingress"
  ethertype         = "IPv4"
  protocol          = "tcp"
  port_range_min    = 8080
  port_range_max    = 8080
  remote_group_id   = openstack_networking_secgroup_v2.sg_web.id
  security_group_id = openstack_networking_secgroup_v2.sg_app.id
}

resource "openstack_networking_secgroup_rule_v2" "app_ssh" {
  direction         = "ingress"
  ethertype         = "IPv4"
  protocol          = "tcp"
  port_range_min    = 22
  port_range_max    = 22
  remote_ip_prefix  = "10.20.0.0/24"
  security_group_id = openstack_networking_secgroup_v2.sg_app.id
}

resource "openstack_networking_secgroup_rule_v2" "app_icmp" {
  direction         = "ingress"
  ethertype         = "IPv4"
  protocol          = "icmp"
  remote_ip_prefix  = "10.20.0.0/24"
  security_group_id = openstack_networking_secgroup_v2.sg_app.id
}

# --- Security Group : BDD ---
resource "openstack_networking_secgroup_v2" "sg_bdd" {
  name        = "sg-bdd"
  description = "MySQL uniquement depuis la VM App"
}

resource "openstack_networking_secgroup_rule_v2" "bdd_from_app_mysql" {
  direction         = "ingress"
  ethertype         = "IPv4"
  protocol          = "tcp"
  port_range_min    = 3306
  port_range_max    = 3306
  remote_group_id   = openstack_networking_secgroup_v2.sg_app.id
  security_group_id = openstack_networking_secgroup_v2.sg_bdd.id
}

resource "openstack_networking_secgroup_rule_v2" "bdd_ssh" {
  direction         = "ingress"
  ethertype         = "IPv4"
  protocol          = "tcp"
  port_range_min    = 22
  port_range_max    = 22
  remote_ip_prefix  = "10.20.0.0/24"
  security_group_id = openstack_networking_secgroup_v2.sg_bdd.id
}

resource "openstack_networking_secgroup_rule_v2" "bdd_icmp" {
  direction         = "ingress"
  ethertype         = "IPv4"
  protocol          = "icmp"
  remote_ip_prefix  = "10.20.0.0/24"
  security_group_id = openstack_networking_secgroup_v2.sg_bdd.id
}

# --- Instances ---
resource "openstack_compute_instance_v2" "vm_web" {
  name            = "vm-web"
  image_name      = var.image_name
  flavor_name     = var.flavor_name
  key_pair        = var.key_pair_name
  security_groups = [openstack_networking_secgroup_v2.sg_web.name]

  network {
    uuid = openstack_networking_network_v2.private_network.id
  }

  depends_on = [openstack_networking_router_interface_v2.router_interface]
}

resource "openstack_compute_instance_v2" "vm_app" {
  name            = "vm-app"
  image_name      = var.image_name
  flavor_name     = var.flavor_name
  key_pair        = var.key_pair_name
  security_groups = [openstack_networking_secgroup_v2.sg_app.name]

  network {
    uuid = openstack_networking_network_v2.private_network.id
  }

  depends_on = [openstack_networking_router_interface_v2.router_interface]
}

resource "openstack_compute_instance_v2" "vm_bdd" {
  name            = "vm-bdd"
  image_name      = var.image_name
  flavor_name     = var.flavor_name
  key_pair        = var.key_pair_name
  security_groups = [openstack_networking_secgroup_v2.sg_bdd.name]

  network {
    uuid = openstack_networking_network_v2.private_network.id
  }

  depends_on = [openstack_networking_router_interface_v2.router_interface]
}

# --- Floating IP pour la VM Web uniquement (point d'entrée public) ---
resource "openstack_networking_floatingip_v2" "web_fip" {
  pool = var.external_network_name
}

resource "openstack_compute_floatingip_associate_v2" "web_fip_associate" {
  floating_ip = openstack_networking_floatingip_v2.web_fip.address
  instance_id = openstack_compute_instance_v2.vm_web.id
}
